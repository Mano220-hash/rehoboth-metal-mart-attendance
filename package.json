{
  "name": "metal-mart",
  "version": "1.0.0",
  "description": "Attendance and Leave Management System for Metal Mart",
  "private": true,
  "scripts": {
    "dev": "node start-dev.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "start": "node start-dev.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "attendance",
    "leave",
    "management",
    "hrms"
  ],
  "author": "Metal Mart",
  "license": "MIT"
}
